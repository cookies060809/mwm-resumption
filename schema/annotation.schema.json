{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ecr-mwm/schema/annotation.schema.json",
  "title": "ECR-MWM annotation record",
  "description": "One P0 or P1 sample record. Version 0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "base_story_id",
    "variant_id",
    "pair_id",
    "domain",
    "split",
    "goal_id",
    "cutoff_event_id",
    "horizon",
    "task_graph",
    "observed_events",
    "state_at_cutoff",
    "state_evidence_event_ids",
    "provenance"
  ],
  "oneOf": [
    {
      "required": ["p0_expectation"],
      "properties": {
        "p0_expectation": {
          "type": "object"
        }
      }
    },
    {
      "required": ["p1_observation"],
      "properties": {
        "p1_observation": {
          "type": "object"
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "base_story_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}[A-Za-z0-9_-]*$"
    },
    "domain": {
      "type": "string",
      "enum": ["work", "daily_life", "collaboration_service", "other"]
    },
    "split": {
      "type": "string",
      "enum": ["train", "dev", "test", "unassigned"]
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_event_id": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["decision_opportunities"]
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "task_graph": {
      "$ref": "task_graph.schema.json"
    },
    "observed_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "events.schema.json"
      }
    },
    "state_at_cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["V", "F", "A", "B", "C", "Q"],
      "properties": {
        "V": {
          "$ref": "state.schema.json#/$defs/V"
        },
        "F": {
          "$ref": "state.schema.json#/$defs/F"
        },
        "A": {
          "$ref": "state.schema.json#/$defs/A"
        },
        "B": {
          "$ref": "state.schema.json#/$defs/B"
        },
        "C": {
          "$ref": "state.schema.json#/$defs/C"
        },
        "Q": {
          "$ref": "state.schema.json#/$defs/Q"
        }
      }
    },
    "state_evidence_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "p0_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scripted_policy",
        "expected_resume",
        "expected_resume_step",
        "rationale"
      ],
      "properties": {
        "scripted_policy": {
          "type": "string",
          "minLength": 1
        },
        "expected_resume": {
          "type": "boolean"
        },
        "expected_resume_step": {
          "type": ["string", "null"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "p1_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_resume", "resume_step", "censoring_status"],
      "properties": {
        "observed_resume": {
          "type": ["boolean", "null"]
        },
        "resume_step": {
          "type": ["string", "null"]
        },
        "censoring_status": {
          "type": "string",
          "enum": [
            "not_collected",
            "complete_window",
            "right_censored",
            "insufficient_evidence"
          ]
        },
        "window_end_event_id": {
          "type": ["string", "null"]
        },
        "window_decision_opportunities": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "evidence_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "counterfactual_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paired_sample_id",
        "controlled_change",
        "information_equivalence"
      ],
      "properties": {
        "paired_sample_id": {
          "type": "string",
          "minLength": 1
        },
        "controlled_change": {
          "type": "string",
          "minLength": 1
        },
        "information_equivalence": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handbook_version", "created_by", "created_at"],
      "properties": {
        "handbook_version": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": ["string", "null"]
        },
        "reviewed_at": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "adjudicated"]
        }
      }
    },
    "access_level": {
      "type": "string",
      "enum": ["public", "internal", "restricted"],
      "default": "internal"
    },
    "notes": {
      "type": "string"
    }
  }
}
