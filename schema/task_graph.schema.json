{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ecr-mwm/schema/task_graph.schema.json",
  "title": "ECR-MWM task graph",
  "description": "Directed acyclic task graph G=(K,D) for one goal. Version 0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "steps"],
  "properties": {
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "label", "depends_on"],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "optional": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
