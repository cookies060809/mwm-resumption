# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Secrets and local configuration
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Local agent workspace (not part of the shared repo)
.workbuddy/

# IDE / OS
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# P1 real human data is access-controlled. Keep only the README and the
# public-derived package in Git.
data/p1/*
!data/p1/README.md
!data/p1/public_derived/

# Raw or private data must not be committed
data/**/raw/
data/**/private/
data/**/restricted/

# Exception: the public-derived P1 package is versioned, but its raw upstream
# annotations stay out of Git. Only the provenance manifests (URL / sha256 / byte
# audits) are committed, so the conversions remain traceable without redistributing
# anyone's data.
!data/p1/public_derived/raw/
data/p1/public_derived/raw/**
!data/p1/public_derived/raw/*/
!data/p1/public_derived/raw/*/_manifest.json
!data/p1/public_derived/raw/*/_upstream_blobs.json
!data/p1/public_derived/raw/*/_upstream_tree_subset.json

# Local dataset-audit scratch space: vendored third-party sources, downloads and
# large extracts. Not part of the shared repo.
p1_audit/

# Competition binaries and large deliverables; keep Markdown sources in Git
competition/artifacts/

# Model artifacts and checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
models/**/checkpoints/

# Generated experiment outputs
results/runs/
results/**/predictions.jsonl
results/**/metrics.json

# Large archives and media
*.zip
*.7z
*.tar
*.tar.gz
*.mp4
*.mov
*.avi
*.wav
*.mp3
*.m4a

# Office temp files
~$*
