# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Secrets and local configuration
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Local agent workspace (not part of the shared repo)
.workbuddy/

# IDE / OS
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# P1 data is access-controlled. Keep only the README in Git.
data/p1/*
!data/p1/README.md

# Raw or private data must not be committed
data/**/raw/
data/**/private/
data/**/restricted/

# Competition binaries and large deliverables; keep Markdown sources in Git
competition/artifacts/

# Model artifacts and checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
models/**/checkpoints/

# Generated experiment outputs
results/runs/
results/full_run/
results/verification/
results/p0_v02/
results/p0_v02_repro/
results/p1_audit/
data/external/raw/
results/**/predictions.jsonl
results/**/metrics.json

# Local engineering environment and generated bundles
.dev-deps/
delivery/
configs/*.local.json
docs/personal/

# Large archives and media
*.zip
*.7z
*.tar
*.tar.gz
*.mp4
*.mov
*.avi
*.wav
*.mp3
*.m4a

# Office temp files
~$*
