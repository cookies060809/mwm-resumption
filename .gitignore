# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Secrets and local configuration
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# IDE / OS
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# P1 data is access-controlled. Keep only the README and templates in Git.
data/p1/*
!data/p1/README.md
!data/p1/templates/
!data/p1/templates/**

# Raw or private data must not be committed
data/**/raw/
data/**/private/
data/**/restricted/

# Model artifacts and checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
models/**/checkpoints/

# Generated experiment outputs
results/runs/
results/**/predictions.jsonl
results/**/metrics.json

# Large archives and media
*.zip
*.7z
*.tar
*.tar.gz
*.mp4
*.mov
*.avi
*.wav
*.mp3
*.m4a

# Office temp files
~$*
